# nemo-anki frontend — Vite build-time env (VITE_* only; baked into the bundle).

# Backend API base (existing).
VITE_API_URL=

# ── Wiser CDP first-party pixel (analytics) ──────────────────────────────────
# Both must be set (in Vercel) for tracking to fire; unset → the pixel no-ops.
# Public client write-key for the nemo-anki org on Wiser CDP.
VITE_CDP_WRITE_KEY=wcdp_nemo_anki_public_key
# Full Wiser CDP ingest URL.
VITE_CDP_INGEST_URL=https://cdp-api.wisry.ai/cdp/ingest
