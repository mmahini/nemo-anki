# Copy to .env and adjust for your environment.
# Used by docker-compose.yml for all services.

DJANGO_SECRET_KEY=dev-insecure-secret-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=nemo_anki
POSTGRES_USER=nemo
POSTGRES_PASSWORD=nemo

# Optional — enables LLM-powered Import (paste book text -> draft cards).
# Without it the importer falls back to a deterministic line parser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Automatic image lookup for cards (Gemini picks a search phrase, Openverse
# supplies the picture). Off by default — the matches are usually poor. Manual
# photo upload is unaffected. Set to 1 here AND VITE_CARD_IMAGE_SEARCH=1 in the
# frontend to turn it back on.
CARD_IMAGE_SEARCH_ENABLED=0

# Broker/result backend for Celery (study-reminder push notifications).
REDIS_URL=redis://redis:6379/0

# Web Push (VAPID) — required for study-reminder notifications to actually
# deliver. Generate a keypair locally (e.g. `npx web-push generate-vapid-keys`)
# and paste the values here; never commit real keys. The public key must also
# be set as VITE_VAPID_PUBLIC_KEY in frontend/.env.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT_EMAIL=support@nemoapps.xyz

# Optional — Telegram as an alternative study-reminder channel. Create a bot
# via @BotFather to get a token + its @username. Without these, "Connect
# Telegram" returns a 503 and the poller idles; push reminders still work.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Reels (apps.reels) — see docs/plans/reels.md -----------------------------
# Instagram reels scraped through Apify, plus reels we upload ourselves. Media
# lands on the R2 bucket already configured above (R2_* vars); with those unset
# it falls back to local media/, which is fine for dev.
#
# Without APIFY_TOKEN the whole scraping side is inert — the admin dashboard,
# manual reel uploads and the Costs page all still work.
APIFY_TOKEN=
APIFY_REEL_ACTOR=apify/instagram-reel-scraper
# Apify bills per reel RETURNED, including ones we already have. Free plan is
# $2.60/1k, Starter $2.30/1k. Used for pre-run estimates and the budget guard.
REELS_RATE_PER_1000=2.60
# "True" arms the hourly auto-poll. Leave unset until real cost is measured —
# then the only way to spend money is the admin's "Fetch now" button.
REELS_SCRAPING_ENABLED=
# Hard monthly ceiling. A run that would cross it is skipped and logged, never
# silently trimmed. $5 matches Apify's free monthly credit.
REELS_MONTHLY_BUDGET_USD=5.00
# Media TTL in days. Purges the stored video, never the row — deleting rows
# would let the next poll re-scrape and re-bill the same reels. 0 = keep forever.
REELS_RETENTION_DAYS=0
# Telegram staff alerts at these percentages of the monthly budget.
REELS_BUDGET_ALERT_PCT=50,80,100
